#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hrm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        td_lower: tap_dance_lower {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Tap Dance Lower";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 1>, <&tog 1>;
        };

        td_raise: tap_dance_raise {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Tap Dance Raise";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 2>, <&tog 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&gresc    &kp Q  &kp W    &kp E    &kp R     &kp T      &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp TAB   &kp A  &kp S    &hrm LALT D &hrm LSHFT F &kp G      &kp H  &hrm RSHFT J &hrm RALT K &kp L    &kp SEMI &kp SQT
&kp RCTRL &kp Z  &kp X    &kp C    &kp V     &kp B      &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                 &kp LALT &td_lower &kp SPACE           &kp RET &td_raise &kp RGUI
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&gresc    &kp N1 &kp N2   &kp N3   &kp N4    &kp N5     &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp DEL
&kp TAB   &trans &trans   &trans   &trans    &trans     &kp LEFT &kp DOWN &kp UP   &kp RIGHT &trans  &trans
&trans    &trans &trans   &trans   &trans    &trans     &trans &trans    &trans    &trans   &trans   &trans
                 &trans   &trans   &trans               &trans &mo 3     &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&trans    &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
&trans    &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH &kp GRAVE
&trans    &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC &kp RBRC &kp PIPE &kp TILDE
                   &trans &mo 3    &trans               &trans    &trans    &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans &trans &trans &trans &trans &trans
&trans     &trans       &trans       &trans       &trans       &trans         &trans &trans &trans &trans &trans &trans
&trans     &trans       &trans       &trans       &trans       &trans         &trans &trans &trans &trans &trans &trans
                        &trans       &trans       &trans                      &trans &trans &trans
            >;
        };
    };
};
